def cadastrar_produto(produtos, nome, preco):
    produtos[nome] = preco


produtos = {}

while True:
    nome = input("\nDigite o nome do produto: ").strip()

    while not nome:
        print("O nome não pode ficar vazio!")
        nome = input("Digite o nome do produto: ").strip()

    try:
        preco = float(input("Digite o preço do produto: R$ "))

        while preco <= 0:
            print("O preço deve ser maior que zero!")
            preco = float(input("Digite um novo preço: R$ "))

        cadastrar_produto(produtos, nome, preco)

    except ValueError:
        print("Digite um preço válido!")
        continue

    continuar = input("Deseja cadastrar outro produto? (s/n): ").lower()

    if continuar != "s":
        break

print("\n--- PRODUTOS CADASTRADOS ---")

for nome, preco in produtos.items():
    print(f"{nome}: R$ {preco:.2f}")
