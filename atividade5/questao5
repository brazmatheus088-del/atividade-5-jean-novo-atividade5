def validar_senha(senha):
    tamanho = len(senha) >= 8
    maiuscula = any(letra.isupper() for letra in senha)
    minuscula = any(letra.islower() for letra in senha)
    numero = any(letra.isdigit() for letra in senha)

    return tamanho and maiuscula and minuscula and numero


while True:
    senha = input("\nDigite uma senha: ")

    if validar_senha(senha):
        print("Senha válida! Cadastro realizado com sucesso.")
        break
    else:
        print("\nSenha inválida!")

        print("A senha deve possuir:")
        print("- Pelo menos 8 caracteres.")
        print("- Uma letra maiúscula.")
        print("- Uma letra minúscula.")
        print("- Um número.")
